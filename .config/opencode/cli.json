{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tokyonight",
    "mode": "system"
  },
  "session": {
    "sidebar": "auto",
    "thinking": "show",
    "tps": true,
    "markdown": "rendered"
  },
  "tabs": {
    "mode": "auto",
    "scope": "cwd"
  },
  "diffs": {
    "source": "working",
    "view": "auto",
    "wrap": "word"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.4
  }
}
